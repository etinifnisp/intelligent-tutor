# Intelligent JEE Tutor — environment template
# Copy to backend/.env and fill in values. Never commit backend/.env.

# ── Current prototype (Gemini) ──────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Local auth (Phase 3) ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Database (Phase 3) ────────────────────────────────────────
# SQLite (hackathon default):
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL (optional):
# DATABASE_URL=postgresql://jee:jee@localhost:5432/jee_tutor

# ── Local model runtime (Phase 5) ─────────────────────────────
MODEL_PROVIDER=gemini
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=gemini-2.5-flash
MODEL_FALLBACK_MODE=mock

# ── Embeddings and retrieval (Phase 4) ─────────────────────
USE_LOCAL_RETRIEVAL=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/indexes/faiss.index
DATA_DIRECTORY=./data

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Deployment hardening
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
RETRIEVAL_CACHE_SIZE=256
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Safety limits ───────────────────────────────────────────
MAX_MESSAGE_LENGTH=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Observability (Phase 9) ───────────────────────────────
LOG_FORMAT=text
LOG_LEVEL=INFO
MODEL_TIMEOUT_SECONDS=30
